NVIDIA_API_KEY=                 # NVIDIA API catalog key (nvapi-...), tried first
NVIDIA_MODEL=                   # e.g. nvidia/nemotron-3-ultra-550b-a55b (lookup + Bangla)
NVIDIA_VISION_MODEL=            # e.g. nvidia/nemotron-3.5-super-vl-120b-a12b (photos)
NVIDIA_BASE_URL=                # blank = https://integrate.api.nvidia.com/v1
NVIDIA_ASR_FUNCTION_ID=         # Whisper large-v3 on build.nvidia.com: copy the function-id from
                                # https://build.nvidia.com/openai/whisper-large-v3/api (blank = voice uses the browser)
NVIDIA_ASR_SERVER=              # blank = grpc.nvcf.nvidia.com:443 (the hosted Riva gRPC endpoint)
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=        # blank = auto-pick a free image model
OPENROUTER_TEXT_MODEL=          # blank = auto-pick a free text model
NARAROUTER_BASE_URL=            # e.g. https://router.bynara.id/v1
NARAROUTER_API_KEY=
NARAROUTER_MODEL=
NARAROUTER_VISION_MODEL=           # optional: model for photos; "none" = text-only, skip for photos
EXPLAB_BASE_URL=                # e.g. https://api.experientiallabs.ai/v1
EXPLAB_API_KEY=
EXPLAB_MODEL=
EXPLAB_VISION_MODEL=           # optional: model for photos; "none" = text-only, skip for photos
AGENTROUTER_BASE_URL=           # e.g. https://agentrouter.org/v1
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=
AGENTROUTER_VISION_MODEL=           # optional: model for photos; "none" = text-only, skip for photos
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=           # optional: a local vision model (e.g. qwen2.5vl:3b) as the last scan fallback
PERPLEXITY_API_KEY=
PERPLEXITY_EFFORT=fast         # Perplexity Agent API tier ("fast" = the old Sonar)
TAVILY_API_KEY=
REVIEWER_TOKEN=                 # shared DEMO reviewer token; works only when DEMO_MODE=true
DEMO_MODE=true                  # false on the pilot server: personal reviewer logins only, no demo reset
ADMIN_TOKEN=                    # creates/revokes reviewer invites and re-issues lost family links (/admin)
PRIVATE_VISION=                 # blank = on when DEMO_MODE=false: photos only go to VISION_PROVIDERS
VISION_PROVIDERS=nvidia,ollama  # providers allowed to see photos when PRIVATE_VISION is on
RESEND_API_KEY=                 # optional: family emails ("results ready", weekly report)
NOTIFY_FROM=                    # e.g. OushodhSathi <hello@your-verified-domain>
PUBLIC_APP_URL=                 # frontend URL used in emails and invite links
N8N_ALERT_WEBHOOK=              # optional: n8n webhook URL for red-flag doctor alerts
OCR_CHECK_DISABLED=             # 1 turns off the OCR second reader (uses NVIDIA_API_KEY; app/ocr_check.py)
# Daily Bangla check-in call (app/voice_calls). Default: the browser simulator, no account, no number.
CALL_PROVIDER=                  # simulator (default); a real adapter is added once a provider is chosen
PUBLIC_API_URL=                 # this API's public URL, for the provider's callback (webhook) address
PHONE_ENCRYPTION_KEY=           # Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AZURE_SPEECH_KEY=               # optional: generate the call prompts with Azure bn-BD voices (backend/scripts/make_call_audio.py)
AZURE_SPEECH_REGION=            # e.g. southeastasia
# Daily WhatsApp check-in message (app/whatsapp_checkin). Unset: the browser simulator runs instead.
WHATSAPP_TOKEN=                 # system-user access token (WhatsApp Cloud API)
WHATSAPP_PHONE_NUMBER_ID=       # the business phone number ID that sends the messages
WHATSAPP_APP_SECRET=            # app secret, to check X-Hub-Signature-256 on webhooks
WHATSAPP_VERIFY_TOKEN=          # any long random string; enter the same in the app's webhook settings
WHATSAPP_BUSINESS_ACCOUNT_ID=   # only for backend/scripts/create_whatsapp_template.py
WHATSAPP_TEMPLATE=              # optional: approved template name (default oushodh_daily_checkin)
WHATSAPP_API_VERSION=           # optional: Graph API version (default v27.0)
CORS_ORIGINS=                   # comma-separated frontend URLs (defaults to localhost:3000)
CORS_ORIGIN_REGEX=              # optional, e.g. preview deploy URLs
OUSHODH_DB=                     # optional SQLite path (default backend/oushodh.db)
DATABASE_URL=                   # Postgres instead of SQLite, e.g. the Supabase session pooler (see docs/DEPLOY.md)
SCAN_LIMIT_PER_IP=10            # photo scans per IP per hour
SCAN_LIMIT_GLOBAL=200           # photo scans per day, all visitors
PATIENT_LIMIT_PER_IP=5          # new households per IP per hour
WRITE_LIMIT_PER_IP=120          # item, check and BP writes per IP per hour
SATHI_LIMIT_PER_IP=60           # questions to Sathi per IP per hour
SATHI_INTENT_MODEL=off            # escalate-only intent classifier; turn on only after eval/run_intent_eval.py passes (200+ human held-out examples)
EMBEDDINGS_DISABLED=              # 1 = never call the embeddings API (Sathi uses keyword search only)
HELP_INDEX_ON_START=              # 1 = build Sathi's vector index at start-up if it is empty (needs NVIDIA_API_KEY)
HELP_VECTOR_ACCEPT=               # blank = 0.50: cosine at which the vector side alone counts as "in the guide"
