OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=        # blank = auto-pick a free image model
OPENROUTER_TEXT_MODEL=          # blank = auto-pick a free text model
NARAROUTER_BASE_URL=            # e.g. https://router.bynara.id/v1
NARAROUTER_API_KEY=
NARAROUTER_MODEL=
NARAROUTER_VISION_MODEL=           # optional: model for photos; "none" = text-only, skip for photos
EXPLAB_BASE_URL=                # e.g. https://api.experientiallabs.ai/v1
EXPLAB_API_KEY=
EXPLAB_MODEL=
EXPLAB_VISION_MODEL=           # optional: model for photos; "none" = text-only, skip for photos
AGENTROUTER_BASE_URL=           # e.g. https://agentrouter.org/v1
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=
AGENTROUTER_VISION_MODEL=           # optional: model for photos; "none" = text-only, skip for photos
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=           # optional: a local vision model (e.g. qwen2.5vl:3b) as the last scan fallback
PERPLEXITY_API_KEY=
PERPLEXITY_EFFORT=fast         # Perplexity Agent API tier ("fast" = the old Sonar)
TAVILY_API_KEY=
REVIEWER_TOKEN=                 # simple shared secret for the reviewer dashboard
DEMO_MODE=true
N8N_ALERT_WEBHOOK=              # optional: n8n webhook URL for red-flag doctor alerts
CORS_ORIGINS=                   # comma-separated frontend URLs (defaults to localhost:3000)
CORS_ORIGIN_REGEX=              # optional, e.g. preview deploy URLs
OUSHODH_DB=                     # optional SQLite path (Render: /var/data/oushodh.db)
